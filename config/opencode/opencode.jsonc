{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/orchestrator.ts", "opencode-supermemory@latest"],
  "share": "disabled",
  "mcp": {
     "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false
    },
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    },
    "expect": {
      "type": "local",
      "command": ["npx", "-y", "expect-cli@latest", "mcp"],
      "enabled": true
    }
  },
  "agent": {
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  }
}